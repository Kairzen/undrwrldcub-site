---
import BrandHead from '@undrwrldcub/brand/BrandHead.astro';
import '../styles/global.css';

interface Props { title: string; description?: string }
const { title, description = 'UndrwrldCub: Pathfinder, Riftbound, Lorcana, WoW: Forever, 3D printing and theme parks.' } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
<BrandHead title={title} description={description} image="/brand/octopus-full.png" />
</head>
<body>
<div style="min-height:100vh;background:#0E0C12;color:#E9E4EE">
<slot />
</div>
</body>
</html>
