---
import Base from '../layouts/Base.astro';
import rawEvents from '../data/riftbound-events.json';

const tag: Record<string, [string, string]> = { casual: ['#1F3327', '#8FD4A4'], prerift: ['#3A2E18', '#EBC374'], competitive: ['#3A2022', '#EDA39A'] };
const events = rawEvents.map((e) => {
  const t = tag[e.kind] || tag.casual;
  const label = e.kind === 'prerift' ? 'Pre\u2011Rift' : e.kind === 'competitive' ? 'Skirmish' : 'Nexus Night';
  return { ...e, kind: label, tagBg: t[0], tagColor: t[1] };
});

// Riot-wide calendar: drawings, releases, Pre-Rift / Skirmish windows, premier events. Single source:
// src/data/riftbound-calendar.json (also loaded into D1 "riftbound" by .github/workflows/riftbound-d1.yml).
import rawRiot from '../data/riftbound-calendar.json';
const MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const riotTag: Record<string, [string, string, string]> = {
  drawing: ['Drawing', '#3A2E18', '#EBC374'],
  drawing_results: ['Drawing results', '#3A2E18', '#EBC374'],
  prerift: ['Pre‑Rift', '#3A2E18', '#EBC374'],
  skirmish: ['Skirmish', '#3A2022', '#EDA39A'],
  nexus_night: ['Nexus Night', '#1F3327', '#8FD4A4'],
  release: ['Release', '#1E2A3A', '#8EC3EE'],
  preview: ['Previews', '#1E2A3A', '#8EC3EE'],
  product: ['Product', '#1E2A3A', '#8EC3EE'],
  promo: ['Promo', '#2E2140', '#C7A6EE'],
  rules: ['Rules', '#2A2A2A', '#CFC8DA'],
  premier: ['Premier event', '#3A2022', '#EDA39A'],
  festival: ['Festival', '#2E2140', '#C7A6EE'],
  convention: ['Convention', '#2E2140', '#C7A6EE'],
};
const statusNote: Record<string, string> = { reported: 'Reported', estimated: 'Estimated', tba: 'Details TBA' };
const md = (d: string) => { const [, m, day] = d.split('-'); return `${MON[+m - 1]} ${+day}`; };
const fmtTime = (t?: string | null) => {
  if (!t) return '';
  const [h, m] = t.split(':').map(Number);
  return ` · ${((h + 11) % 12) + 1}${m ? ':' + String(m).padStart(2, '0') : ''} ${h < 12 ? 'AM' : 'PM'} PT`;
};
const today = new Date().toISOString().slice(0, 10);
const riot = rawRiot
  .filter((r) => (r.end_date ?? r.start_date) >= today)
  .sort((a, b) => a.start_date.localeCompare(b.start_date))
  .map((r) => {
    const [label, bg, color] = riotTag[r.kind] ?? riotTag.product;
    const [, m, d] = r.start_date.split('-');
    const when = r.end_date && r.end_date !== r.start_date ? `${md(r.start_date)} – ${md(r.end_date)}` : md(r.start_date);
    return { ...r, label, bg, color, mon: MON[+m - 1], day: String(+d), when: when + fmtTime(r.start_time_pt),
      last: r.end_date ?? r.start_date, flag: statusNote[r.status ?? ''] };
  });

// News and the judge corner. Sources: src/data/riftbound-news.json (newest first; loaded into D1 rb_news
// with the calendar) and src/data/riftbound-rules.json (current rules documents and ban list).
import rawNews from '../data/riftbound-news.json';
import rulesRef from '../data/riftbound-rules.json';
const newsCat: Record<string, [string, string, string]> = {
  rules: ['Rules', '#2A2A2A', '#CFC8DA'],
  judge: ['Judge', '#3A2E18', '#EBC374'],
  organized_play: ['Organized play', '#3A2022', '#EDA39A'],
  product: ['Product', '#2E2140', '#C7A6EE'],
  announcement: ['Announcement', '#1E2A3A', '#8EC3EE'],
  event_report: ['Event report', '#1F3327', '#8FD4A4'],
};
const longDate = (d: string) => { const [y, m, day] = d.split('-'); return `${MON[+m - 1]} ${+day}, ${y}`; };
const NEWS_SHOWN = 8;
const news = rawNews.map((n, i) => {
  const [label, bg, color] = newsCat[n.category] ?? newsCat.announcement;
  const cats = [n.category, ...(n.judge_note && n.category !== 'judge' ? ['judge'] : [])];
  const host = new URL(n.url).hostname.replace(/^www\./, '');
  const cta = /youtu/.test(host) ? 'Watch on YouTube' : /\.pdf$/i.test(n.url) ? 'Open the PDF' : `Read on ${host}`;
  return { ...n, label, bg, color, cats: cats.join(' '), date: longDate(n.published), cta, older: i >= NEWS_SHOWN,
    effective: n.effective_date ? `Effective ${md(n.effective_date)}` : '' };
});
const newsFilters = [['all', 'All'], ['rules', 'Rules'], ['judge', 'Judge'], ['organized_play', 'Organized play'],
  ['product', 'Product'], ['announcement', 'Announcements'], ['event_report', 'Event reports']]
  .map(([key, label]) => ({ key, label, n: key === 'all' ? news.length : news.filter((x) => x.cats.split(' ').includes(key)).length }))
  .filter((f) => f.n > 0);
const docs = rulesRef.documents.map((d) => ({ ...d, when: longDate(d.updated) }));
const banned = rulesRef.banned;
---
<Base title="Riftbound · UndrwrldCub">
<header style="position:sticky;top:0;z-index:50;background:rgba(14,12,18,.92);backdrop-filter:blur(10px);border-bottom:1px solid #2D2838">
  <div style="max-width:1160px;margin:0 auto;padding:0 20px;height:64px;display:flex;align-items:center;gap:18px">
    <a href="/" style="display:flex;align-items:center;gap:10px;color:#F6F1FA;font-family:'Cinzel',Georgia,serif;font-weight:700;font-size:19px;white-space:nowrap">
      <img src="/brand/octopus-192.png" alt="" style="width:40px;height:40px;object-fit:contain"><span>UndrwrldCub</span>
    </a>
    <a href="/#realms" style="margin-left:auto;font-family:'Barlow Semi Condensed',sans-serif;font-weight:600;font-size:16px;color:#A69DB4;padding:8px 10px;border-radius:8px"class="nav-link">← All realms</a>
  </div>
</header>

<section style="border-bottom:1px solid #2D2838;background:linear-gradient(180deg,rgba(111,178,232,.10),#0E0C12 90%)">
  <div style="max-width:1160px;margin:0 auto;padding:36px 20px 32px;display:flex;gap:18px;align-items:flex-start;flex-wrap:wrap">
    <div style="width:58px;height:58px;border-radius:14px;flex:0 0 auto;display:inline-flex;align-items:center;justify-content:center;font-family:'Cinzel',Georgia,serif;font-weight:700;font-size:26px;color:#6FB2E8;background:rgba(111,178,232,.16);border:1px solid rgba(111,178,232,.4)">R</div>
    <div style="flex:1 1 320px;min-width:0">
      <div style="font-family:'Barlow Semi Condensed',sans-serif;font-size:13px;letter-spacing:.16em;text-transform:uppercase;font-weight:600;color:#6FB2E8">Collection</div>
      <h1 style="font-family:'Cinzel',Georgia,serif;font-weight:700;font-size:clamp(30px,4.4vw,46px);line-height:1.2;margin:4px 0 8px;color:#F6F1FA">Riftbound</h1>
      <p style="font-size:18px;color:#A69DB4;max-width:72ch;margin:0;text-wrap:pretty">The League of Legends trading card game. We collect it, we play it, and every Friday we run Nexus Night at our local shop.</p>
    </div>
  </div>
</section>

<main style="max-width:1160px;margin:0 auto;padding:0 20px">
  <section style="margin-top:44px;position:relative;display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:28px 36px;padding:30px 34px;border:1px solid #6B5628;border-radius:16px;background:linear-gradient(135deg,rgba(32,28,41,.92),rgba(20,17,27,.92));box-shadow:0 30px 60px -30px rgba(0,0,0,.9),inset 0 1px 0 rgba(230,189,102,.12)">
    <div style="position:absolute;left:24px;right:24px;top:-1px;height:2px;background:linear-gradient(90deg,transparent,#D4A64A,#6FB2E8,transparent);border-radius:2px"></div>
    <div>
      <div style="font-family:'Barlow Semi Condensed',sans-serif;font-size:13px;letter-spacing:.16em;text-transform:uppercase;font-weight:600;color:#D4A64A">Weekly · Organized play</div>
      <h2 style="font-family:'Cinzel',Georgia,serif;font-weight:700;font-size:clamp(30px,4vw,46px);line-height:1.05;color:#F6F1FA;margin:10px 0 8px">Nexus Night</h2>
      <p style="font-size:18px;color:#A69DB4;margin:0 0 20px;text-wrap:pretty">Every Friday we run Riftbound at Big Deck Energy Games in Cathedral City. Casual matches, new players welcome, decks to borrow if you don't have one yet.</p>
      <div style="display:flex;gap:10px;flex-wrap:wrap;font-family:'Barlow Semi Condensed',sans-serif">
        <div style="min-width:96px;padding:10px 14px 8px;border:1px solid #3A3347;border-radius:12px;background:#13111A;text-align:center">
          <b style="display:block;font-family:'IBM Plex Mono',monospace;font-weight:500;font-size:26px;line-height:1.2;color:#F6F1FA">FRI</b>
          <span style="font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:#A69DB4">Every week</span>
        </div>
        <div style="min-width:96px;padding:10px 14px 8px;border:1px solid #3A3347;border-radius:12px;background:#13111A;text-align:center">
          <b style="display:block;font-family:'IBM Plex Mono',monospace;font-weight:500;font-size:26px;line-height:1.2;color:#F6F1FA">6–10</b>
          <span style="font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:#A69DB4">PM</span>
        </div>
      </div>
    </div>
    <div style="border-left:1px solid #3A3347;padding-left:32px;font-family:'Barlow Semi Condensed',sans-serif;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center">
      <div style="color:#A69DB4;font-size:13px;letter-spacing:.14em;text-transform:uppercase;font-weight:600">Where</div>
      <div style="font-family:'Cinzel',Georgia,serif;font-weight:700;font-size:22px;color:#F6F1FA;margin:8px 0 4px">Big Deck Energy Games</div>
      <div style="font-size:16px;color:#E9E4EE;line-height:1.5">67555 E Palm Canyon Dr, Ste F101<br>Cathedral City, CA 92234<br><span style="color:#A69DB4">Canyon Plaza Shopping Center</span></div>
      <div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:16px;justify-content:center">
        <a href="https://bigdeckenergygames.com/" style="display:inline-flex;align-items:center;justify-content:center;height:42px;padding:0 18px;border-radius:10px;font-weight:600;font-size:16px;background:#D4A64A;color:#1A1408"class="btn-gold">Store site</a>
        <a href="https://maps.apple.com/place?place-id=IC145941D3ABD758A" style="display:inline-flex;align-items:center;justify-content:center;height:42px;padding:0 18px;border-radius:10px;font-weight:600;font-size:16px;border:1px solid #6B5628;color:#E9E4EE;background:rgba(24,21,31,.6)"class="btn-outline">Directions</a>
      </div>
    </div>
  </section>

  <section id="news" style="margin-top:52px">
    <div style="display:flex;align-items:baseline;justify-content:space-between;gap:12px;flex-wrap:wrap">
      <h2 style="font-family:'Cinzel',Georgia,serif;font-size:clamp(22px,2.4vw,28px);font-weight:700;margin:0;color:#F6F1FA">Riftbound news</h2>
      <a href="https://playriftbound.com/en-us/news/" style="font-family:'Barlow Semi Condensed',sans-serif;font-weight:600;font-size:16px;white-space:nowrap">All of Riot's news →</a>
    </div>
    <div style="width:44px;height:2px;margin:8px 0 6px;background:linear-gradient(90deg,#6FB2E8,transparent)"></div>
    <p style="margin:0 0 16px;font-size:15px;color:#A69DB4">Rules updates, organized play changes and product news, newest first. Every item links to the article itself; items that change how we run events carry a judge's note.</p>
    <div class="rb-news-filters" role="group" aria-label="Filter news" style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px;font-family:'Barlow Semi Condensed',sans-serif">
      {newsFilters.map((f) => (
        <button type="button" class="rb-nf" data-cat={f.key} aria-pressed={f.key === 'all' ? 'true' : 'false'}>{f.label} <span style="color:#756D84">{f.n}</span></button>
      ))}
    </div>
    <div style="border:1px solid #2D2838;border-radius:12px;background:#18151F;padding:6px 16px">
      <ul id="rb-news-list" style="list-style:none;margin:0;padding:0">
        {news.map((n) => (
          <li data-cats={n.cats} data-older={n.older ? '1' : undefined} hidden={n.older} style="padding:16px 0;border-bottom:1px solid #2D2838">
            <div style="display:flex;flex-wrap:wrap;gap:6px 12px;align-items:center;font-family:'Barlow Semi Condensed',sans-serif;font-size:14px;color:#A69DB4">
              <span style={`font-weight:600;font-size:12.5px;letter-spacing:.05em;text-transform:uppercase;padding:1px 8px;border-radius:4px;background:${n.bg};color:${n.color}`}>{n.label}</span>
              <time datetime={n.published}>{n.date}</time>
              <span>{n.source}</span>
              {n.effective && <span style="font-size:12.5px;letter-spacing:.05em;text-transform:uppercase;padding:0 7px;border:1px solid #4A4258;border-radius:4px;color:#CFC8DA">{n.effective}</span>}
            </div>
            <h3 style="margin:6px 0 4px;font-size:18px;line-height:1.3"><a href={n.url} target="_blank" rel="noopener" style="color:#F6F1FA">{n.title}</a></h3>
            <p style="margin:0;font-size:15px;color:#A69DB4;max-width:80ch;text-wrap:pretty">{n.summary}</p>
            {n.judge_note && (
              <div style="margin-top:10px;max-width:80ch;padding:10px 14px;border-left:3px solid #D4A64A;border-radius:0 8px 8px 0;background:rgba(212,166,74,.08);font-size:14.5px;color:#E9E4EE">
                <span style="font-family:'Barlow Semi Condensed',sans-serif;font-weight:600;font-size:12.5px;letter-spacing:.1em;text-transform:uppercase;color:#E6BD66;margin-right:8px">Judge's note</span>{n.judge_note}
              </div>
            )}
            <a href={n.url} target="_blank" rel="noopener" style="display:inline-block;margin-top:8px;font-size:14px">{n.cta} ↗</a>
          </li>
        ))}
      </ul>
      <p id="rb-news-empty" hidden style="margin:14px 0;color:#A69DB4;font-size:15px">Nothing in this category yet.</p>
      {news.some((n) => n.older) && <button type="button" id="rb-news-more" class="rb-nf" style="margin:14px 0 10px">Show older news</button>}
    </div>
  </section>
  <script is:inline>
    (() => {
      const btns = document.querySelectorAll('.rb-nf[data-cat]');
      const items = document.querySelectorAll('#rb-news-list li');
      const empty = document.getElementById('rb-news-empty');
      const more = document.getElementById('rb-news-more');
      let cat = 'all', all = false;
      const apply = () => {
        let shown = 0;
        items.forEach((li) => {
          const match = cat === 'all' || li.dataset.cats.split(' ').includes(cat);
          const on = match && (all || cat !== 'all' || !li.dataset.older);
          li.hidden = !on; if (on) shown++;
        });
        empty.hidden = shown > 0;
        if (more) more.hidden = all || cat !== 'all';
        btns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.cat === cat)));
      };
      btns.forEach((b) => b.addEventListener('click', () => { cat = b.dataset.cat; apply(); }));
      if (more) more.addEventListener('click', () => { all = true; apply(); });
    })();
  </script>

  <section id="judge" style="margin-top:52px;position:relative;padding:30px 34px;border:1px solid #6B5628;border-radius:16px;background:linear-gradient(135deg,rgba(32,28,41,.92),rgba(20,17,27,.92));box-shadow:0 30px 60px -30px rgba(0,0,0,.9),inset 0 1px 0 rgba(230,189,102,.12)">
    <div style="position:absolute;left:24px;right:24px;top:-1px;height:2px;background:linear-gradient(90deg,transparent,#D4A64A,#6FB2E8,transparent);border-radius:2px"></div>
    <div style="font-family:'Barlow Semi Condensed',sans-serif;font-size:13px;letter-spacing:.16em;text-transform:uppercase;font-weight:600;color:#D4A64A">Big Deck Energy · Riftbound judge</div>
    <h2 style="font-family:'Cinzel',Georgia,serif;font-weight:700;font-size:clamp(26px,3.4vw,38px);line-height:1.1;color:#F6F1FA;margin:10px 0 8px">The judge's table</h2>
    <p style="font-size:17px;color:#A69DB4;max-width:76ch;margin:0 0 22px;text-wrap:pretty">We judge the Riftbound events at Big Deck Energy Games. If a game state looks wrong or a card does something you didn't expect, raise a hand and call "judge." Asking is never a penalty, and the earlier we see an error, the simpler the fix.</p>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:22px 32px">
      <div>
        <h3 style="margin:0 0 10px;font-size:19px;color:#F6F1FA">How we run the table</h3>
        <ul style="list-style:none;margin:0;padding:0;display:grid;gap:8px;font-size:15px;color:#E9E4EE">
          <li style="display:flex;gap:10px"><span style="color:#E4B45A">◆</span><span><strong style="color:#F6F1FA">Nexus Night and Pre‑Rift are casual.</strong> We fix the game and keep it friendly. Letting an opponent take back a misplay isn't required, but we encourage it.</span></li>
          <li style="display:flex;gap:10px"><span style="color:#E4B45A">◆</span><span><strong style="color:#F6F1FA">Summoner Skirmish is competitive.</strong> Registered decks and Tournament Rules penalties. Once your opponent has had to point something out, your decision stands.</span></li>
          <li style="display:flex;gap:10px"><span style="color:#E4B45A">◆</span><span><strong style="color:#F6F1FA">Deck checks happen at the start of a round</strong> and cover the whole deck: main deck, runes, Battlefields, Legend and sideboard.</span></li>
          <li style="display:flex;gap:10px"><span style="color:#E4B45A">◆</span><span><strong style="color:#F6F1FA">Notes are fine until opening hands.</strong> Look at your notes while sideboarding; put them away once you draw.</span></li>
          <li style="display:flex;gap:10px"><span style="color:#E4B45A">◆</span><span><strong style="color:#F6F1FA">Bluffing about hidden information is legal.</strong> Lying about public information, or how a card works, is not.</span></li>
          <li style="display:flex;gap:10px"><span style="color:#E4B45A">◆</span><span><strong style="color:#F6F1FA">Tokens need a real card object</strong> with a clear ready or exhausted state your opponent can read.</span></li>
          <li style="display:flex;gap:10px"><span style="color:#E4B45A">◆</span><span><strong style="color:#F6F1FA">Errata and the FAQ beat the printed card.</strong> We rule from the current text below.</span></li>
        </ul>
      </div>
      <div style="display:grid;gap:18px;align-content:start">
        <div>
          <h3 style="margin:0 0 10px;font-size:19px;color:#F6F1FA">Current rules documents</h3>
          <ul style="list-style:none;margin:0;padding:0;border:1px solid #3A3347;border-radius:12px;background:#13111A">
            {docs.map((d, i) => (
              <li style={`display:flex;gap:12px;justify-content:space-between;align-items:baseline;padding:10px 14px;${i ? 'border-top:1px solid #2D2838;' : ''}`}>
                <div style="min-width:0"><a href={d.url} target="_blank" rel="noopener" style="font-weight:600">{d.name}</a><div style="font-size:13.5px;color:#A69DB4">{d.note}</div></div>
                <span style="flex:0 0 auto;font-family:'IBM Plex Mono',monospace;font-size:13px;color:#756D84">{d.when}</span>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h3 style="margin:0 0 4px;font-size:19px;color:#F6F1FA">Banned in Constructed</h3>
          <div style="font-size:13.5px;color:#756D84;margin-bottom:10px">Updated {longDate(banned.updated)} · all sets are legal; rotation starts in 2028</div>
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px 18px;font-size:14.5px;color:#E9E4EE">
            <div><div style="font-family:'Barlow Semi Condensed',sans-serif;font-size:12px;letter-spacing:.12em;text-transform:uppercase;font-weight:600;color:#A69DB4;margin-bottom:4px">Cards</div>{banned.constructed.cards.map((c) => <div>{c}</div>)}</div>
            <div><div style="font-family:'Barlow Semi Condensed',sans-serif;font-size:12px;letter-spacing:.12em;text-transform:uppercase;font-weight:600;color:#A69DB4;margin-bottom:4px">Battlefields</div>{banned.constructed.battlefields.map((c) => <div>{c}</div>)}</div>
          </div>
          <div style="margin-top:8px;font-size:13.5px;color:#A69DB4">2v2 Constructed also bans {banned.two_v_two_extra_legends.join(', ')}. <a href={banned.source_url} target="_blank" rel="noopener">Rules Hub ↗</a></div>
        </div>
        <div style="padding:12px 14px;border:1px solid #3A3347;border-radius:12px;background:#13111A;font-size:14.5px;color:#A69DB4">
          <strong style="color:#F6F1FA">Want to judge?</strong> UVS runs the certification test from your Riftbound account. <a href={rulesRef.judge.become_url} target="_blank" rel="noopener">Take the judge test ↗</a>
        </div>
      </div>
    </div>
  </section>

  <section style="margin-top:28px">
    <div style="display:flex;align-items:baseline;justify-content:space-between;gap:12px;flex-wrap:wrap">
      <h2 style="font-family:'Cinzel',Georgia,serif;font-size:clamp(20px,2.2vw,24px);font-weight:700;margin:0;color:#F6F1FA">On the shelf now: Radiance</h2>
      <span style="font-family:'Barlow Semi Condensed',sans-serif;font-size:15px;color:#A69DB4">180 cards · 60+ showcase · 14‑card boosters</span>
    </div>
    <div style="width:44px;height:2px;margin:8px 0 16px;background:linear-gradient(90deg,#E4B45A,transparent)"></div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px">
      <div style="display:flex;flex-direction:column;background:#18151F;border:1px solid #2D2838;border-radius:12px;overflow:hidden">
        <div style="height:150px;background:#000;display:flex;align-items:center;justify-content:center;padding:10px"><img src="/riftbound/booster.jpg" alt="Radiance booster pack" style="max-width:100%;max-height:100%;object-fit:contain"></div>
        <div style="padding:14px 16px 16px">
          <div style="font-weight:600;color:#F6F1FA">Booster Display</div>
          <div style="font-size:14px;color:#A69DB4;margin-top:2px">24 packs of 14 cards. 2 foil rares or better per pack. $120 per display.</div>
        </div>
      </div>
      <div style="display:flex;flex-direction:column;background:#18151F;border:1px solid #2D2838;border-radius:12px;overflow:hidden">
