---
import Base from '../layouts/Base.astro';
import rawEvents from '../data/riftbound-events.json';

const tag: Record<string, [string, string]> = { casual: ['#1F3327', '#8FD4A4'], prerift: ['#3A2E18', '#EBC374'], competitive: ['#3A2022', '#EDA39A'] };
const events = rawEvents.map((e) => {
  const t = tag[e.kind] || tag.casual;
  const label = e.kind === 'prerift' ? 'Pre\u2011Rift' : e.kind === 'competitive' ? 'Skirmish' : 'Nexus Night';
  return { ...e, kind: label, tagBg: t[0], tagColor: t[1] };
});
---
<Base title="Riftbound · UndrwrldCub">
<header style="position:sticky;top:0;z-index:50;background:rgba(14,12,18,.92);backdrop-filter:blur(10px);border-bottom:1px solid #2D2838">
  <div style="max-width:1160px;margin:0 auto;padding:0 20px;height:64px;display:flex;align-items:center;gap:18px">
    <a href="/" style="display:flex;align-items:center;gap:10px;color:#F6F1FA;font-family:'Cinzel',Georgia,serif;font-weight:700;font-size:19px;white-space:nowrap">
      <img src="/brand/octopus-192.png" alt="" style="width:40px;height:40px;object-fit:contain"><span>UndrwrldCub</span>
    </a>
    <a href="/#realms" style="margin-left:auto;font-family:'Barlow Semi Condensed',sans-serif;font-weight:600;font-size:16px;color:#A69DB4;padding:8px 10px;border-radius:8px"class="nav-link">← All realms</a>
  </div>
</header>

<section style="border-bottom:1px solid #2D2838;background:linear-gradient(180deg,rgba(111,178,232,.10),#0E0C12 90%)">
  <div style="max-width:1160px;margin:0 auto;padding:36px 20px 32px;display:flex;gap:18px;align-items:flex-start;flex-wrap:wrap">
    <div style="width:58px;height:58px;border-radius:14px;flex:0 0 auto;display:inline-flex;align-items:center;justify-content:center;font-family:'Cinzel',Georgia,serif;font-weight:700;font-size:26px;color:#6FB2E8;background:rgba(111,178,232,.16);border:1px solid rgba(111,178,232,.4)">R</div>
    <div style="flex:1 1 320px;min-width:0">
      <div style="font-family:'Barlow Semi Condensed',sans-serif;font-size:13px;letter-spacing:.16em;text-transform:uppercase;font-weight:600;color:#6FB2E8">Collection</div>
      <h1 style="font-family:'Cinzel',Georgia,serif;font-weight:700;font-size:clamp(30px,4.4vw,46px);line-height:1.2;margin:4px 0 8px;color:#F6F1FA">Riftbound</h1>
      <p style="font-size:18px;color:#A69DB4;max-width:72ch;margin:0;text-wrap:pretty">The League of Legends trading card game. We collect it, we play it, and every Friday we run Nexus Night at our local shop.</p>
    </div>
  </div>
</section>

<main style="max-width:1160px;margin:0 auto;padding:0 20px">
  <section style="margin-top:44px;position:relative;display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:28px 36px;padding:30px 34px;border:1px solid #6B5628;border-radius:16px;background:linear-gradient(135deg,rgba(32,28,41,.92),rgba(20,17,27,.92));box-shadow:0 30px 60px -30px rgba(0,0,0,.9),inset 0 1px 0 rgba(230,189,102,.12)">
    <div style="position:absolute;left:24px;right:24px;top:-1px;height:2px;background:linear-gradient(90deg,transparent,#D4A64A,#6FB2E8,transparent);border-radius:2px"></div>
    <div>
      <div style="font-family:'Barlow Semi Condensed',sans-serif;font-size:13px;letter-spacing:.16em;text-transform:uppercase;font-weight:600;color:#D4A64A">Weekly · Organized play</div>
      <h2 style="font-family:'Cinzel',Georgia,serif;font-weight:700;font-size:clamp(30px,4vw,46px);line-height:1.05;color:#F6F1FA;margin:10px 0 8px">Nexus Night</h2>
      <p style="font-size:18px;color:#A69DB4;margin:0 0 20px;text-wrap:pretty">Every Friday we run Riftbound at Big Deck Energy Games in Cathedral City. Casual matches, new players welcome, decks to borrow if you don't have one yet.</p>
      <div style="display:flex;gap:10px;flex-wrap:wrap;font-family:'Barlow Semi Condensed',sans-serif">
        <div style="min-width:96px;padding:10px 14px 8px;border:1px solid #3A3347;border-radius:12px;background:#13111A;text-align:center">
          <b style="display:block;font-family:'IBM Plex Mono',monospace;font-weight:500;font-size:26px;line-height:1.2;color:#F6F1FA">FRI</b>
          <span style="font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:#A69DB4">Every week</span>
        </div>
        <div style="min-width:96px;padding:10px 14px 8px;border:1px solid #3A3347;border-radius:12px;background:#13111A;text-align:center">
          <b style="display:block;font-family:'IBM Plex Mono',monospace;font-weight:500;font-size:26px;line-height:1.2;color:#F6F1FA">6–10</b>
          <span style="font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:#A69DB4">PM</span>
        </div>
      </div>
    </div>
    <div style="border-left:1px solid #3A3347;padding-left:32px;font-family:'Barlow Semi Condensed',sans-serif;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center">
      <div style="color:#A69DB4;font-size:13px;letter-spacing:.14em;text-transform:uppercase;font-weight:600">Where</div>
      <div style="font-family:'Cinzel',Georgia,serif;font-weight:700;font-size:22px;color:#F6F1FA;margin:8px 0 4px">Big Deck Energy Games</div>
      <div style="font-size:16px;color:#E9E4EE;line-height:1.5">67555 E Palm Canyon Dr, Ste F101<br>Cathedral City, CA 92234<br><span style="color:#A69DB4">Canyon Plaza Shopping Center</span></div>
      <div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:16px;justify-content:center">
        <a href="https://bigdeckenergygames.com/" style="display:inline-flex;align-items:center;justify-content:center;height:42px;padding:0 18px;border-radius:10px;font-weight:600;font-size:16px;background:#D4A64A;color:#1A1408"class="btn-gold">Store site</a>
        <a href="https://maps.apple.com/place?place-id=IC145941D3ABD758A" style="display:inline-flex;align-items:center;justify-content:center;height:42px;padding:0 18px;border-radius:10px;font-weight:600;font-size:16px;border:1px solid #6B5628;color:#E9E4EE;background:rgba(24,21,31,.6)"class="btn-outline">Directions</a>
      </div>
    </div>
  </section>

  <section id="prerift" style="margin-top:52px;position:relative;border:1px solid #6B5628;border-radius:18px;overflow:hidden;background:#0c0b10;box-shadow:0 40px 80px -40px rgba(0,0,0,.95)">
    <div style="position:absolute;inset:0;pointer-events:none;background:radial-gradient(70% 90% at 80% 20%,rgba(212,166,74,.22),transparent 65%),radial-gradient(60% 80% at 10% 100%,rgba(155,107,224,.28),transparent 70%)"></div>
    <div style="position:relative;display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));min-height:380px">
      <div style="position:relative;min-height:260px">
        <img src="/riftbound/radiance-keyart.jpg" alt="Riftbound: Radiance key art featuring Ekko and Seraphine" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 12%">
        <div style="position:absolute;inset:0;pointer-events:none;background:linear-gradient(90deg,transparent 55%,#0c0b10 100%),linear-gradient(0deg,rgba(12,11,16,.7) 0%,transparent 30%)"></div>
      </div>
      <div style="position:relative;padding:32px 34px 30px;display:flex;flex-direction:column;gap:14px">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap">
          <div style="font-family:'Barlow Semi Condensed',sans-serif;font-size:13px;letter-spacing:.16em;text-transform:uppercase;font-weight:600;color:#E4B45A">Pre‑Rift · Set 5 · Sealed</div>
        </div>
        <img src="/riftbound/radiance-wordmark.jpg" alt="Radiance" style="display:block;width:min(100%,340px);height:auto;mix-blend-mode:screen">
        <h2 style="font-family:'Cinzel',Georgia,serif;font-weight:700;font-size:clamp(26px,3.2vw,36px);line-height:1.08;color:#F6F1FA;margin:0;background:linear-gradient(180deg,#FBF6FF 30%,#EBC374 100%);-webkit-background-clip:text;background-clip:text;color:transparent">Own the stage. Open the set first.</h2>
        <div style="display:flex;gap:10px;flex-wrap:wrap;font-family:'Barlow Semi Condensed',sans-serif">
          <div style="display:flex;flex-direction:column;align-items:center;min-width:72px;border:1px solid #6B5628;border-radius:10px;overflow:hidden;background:#13111A;line-height:1.1">
            <span style="width:100%;text-align:center;background:rgba(212,166,74,.22);color:#E6BD66;font-weight:600;font-size:12px;letter-spacing:.12em;text-transform:uppercase;padding:3px 0">Oct</span>
            <span style="font-family:'IBM Plex Mono',monospace;font-size:26px;color:#F6F1FA;padding:6px 0 7px">16</span>
          </div>
          <div style="padding:8px 14px;border:1px solid #3A3347;border-radius:10px;background:#13111A">
            <div style="font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:#A69DB4">Friday</div>
            <div style="font-family:'IBM Plex Mono',monospace;font-size:20px;color:#F6F1FA">6:00–10:00 PM</div>
          </div>
          <div style="padding:8px 14px;border:1px solid #3A3347;border-radius:10px;background:#13111A">
            <div style="font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:#A69DB4">Where</div>
            <div style="font-size:16px;font-weight:600;color:#F6F1FA">Big Deck Energy Games</div>
          </div>
          <div style="padding:8px 14px;border:1px solid #3A3347;border-radius:10px;background:#13111A">
            <div style="font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:#A69DB4">Seats</div>
            <div style="font-family:'IBM Plex Mono',monospace;font-size:20px;color:#F6F1FA">24</div>
          </div>
        </div>
        <ul style="list-style:none;margin:0;padding:0;display:grid;gap:6px;font-size:15px;color:#E9E4EE">
          <li style="display:flex;gap:10px"><span style="color:#E4B45A">◆</span><span>Your Pre‑Rift kit: a 15‑card mini‑deck seeded with one of nine new Legends (Champion Legend, Champion Unit, and its runes), plus five Radiance boosters. Everything is yours to keep.</span></li>
          <li style="display:flex;gap:10px"><span style="color:#E4B45A">◆</span><span>Heimerdinger, Academy Instructor Pre‑Rift promo for every player, while supplies last. Booster prizes from a full Radiance display.</span></li>
          <li style="display:flex;gap:10px"><span style="color:#E4B45A">◆</span><span>Build from what you open, then a paired sealed tournament. Beginner‑friendly by design.</span></li>
          <li style="display:flex;gap:10px"><span style="color:#E4B45A">◆</span><span>24 seats. Sign‑up strongly suggested; this will sell out.</span></li>
        </ul>
        <div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:auto;padding-top:6px">
          <a href="https://playriftbound.com/events" style="display:inline-flex;align-items:center;justify-content:center;height:46px;padding:0 20px;border-radius:10px;font-family:'Barlow Semi Condensed',sans-serif;font-weight:600;font-size:17px;background:#D4A64A;color:#1A1408;box-shadow:0 6px 20px -8px rgba(212,166,74,.7)"class="btn-gold">Sign up on PlayRiftbound.com</a>
        </div>
        <div style="font-size:12.5px;color:#756D84">Radiance releases Oct 23. Riftbound: League of Legends ™ &amp; © 2026 Riot Games, Inc. Artwork used under license via UVS Games retailer materials to promote a sanctioned store event.</div>
      </div>
    </div>
  </section>

  <section style="margin-top:28px">
    <div style="display:flex;align-items:baseline;justify-content:space-between;gap:12px;flex-wrap:wrap">
      <h2 style="font-family:'Cinzel',Georgia,serif;font-size:clamp(20px,2.2vw,24px);font-weight:700;margin:0;color:#F6F1FA">On the shelf October 23</h2>
      <span style="font-family:'Barlow Semi Condensed',sans-serif;font-size:15px;color:#A69DB4">180 cards · 60+ showcase · 14‑card boosters</span>
    </div>
    <div style="width:44px;height:2px;margin:8px 0 16px;background:linear-gradient(90deg,#E4B45A,transparent)"></div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px">
      <div style="display:flex;flex-direction:column;background:#18151F;border:1px solid #2D2838;border-radius:12px;overflow:hidden">
        <div style="height:150px;background:#000;display:flex;align-items:center;justify-content:center;padding:10px"><img src="/riftbound/booster.jpg" alt="Radiance booster pack" style="max-width:100%;max-height:100%;object-fit:contain"></div>
        <div style="padding:14px 16px 16px">
          <div style="font-weight:600;color:#F6F1FA">Booster Display</div>
          <div style="font-size:14px;color:#A69DB4;margin-top:2px">24 packs of 14 cards. 2 foil rares or better per pack. $120 per display.</div>
        </div>
      </div>
      <div style="display:flex;flex-direction:column;background:#18151F;border:1px solid #2D2838;border-radius:12px;overflow:hidden">
        <div style="height:150px;background:#000;display:flex;align-items:center;justify-content:center;padding:10px"><img src="/riftbound/showdown-decks.jpg" alt="Showdown Decks: Evelynn vs Seraphine" style="max-width:100%;max-height:100%;object-fit:contain"></div>
        <div style="padding:14px 16px 16px">
          <div style="font-weight:600;color:#F6F1FA">Showdown Decks</div>
          <div style="font-size:14px;color:#A69DB4;margin-top:2px">Evelynn vs Seraphine. Two 56‑card decks, two playmats, two boosters. The best start for a new player. $34.99.</div>
        </div>
      </div>
      <div style="display:flex;flex-direction:column;background:#18151F;border:1px solid #2D2838;border-radius:12px;overflow:hidden">
        <div style="height:150px;background:#000;display:flex;align-items:center;justify-content:center;padding:10px"><img src="/riftbound/vault.jpg" alt="Radiance Vault" style="max-width:100%;max-height:100%;object-fit:contain"></div>
        <div style="padding:14px 16px 16px">
          <div style="font-weight:600;color:#F6F1FA">Vault</div>
          <div style="font-size:14px;color:#A69DB4;margin-top:2px">6 boosters, 3 foil promo tokens, 36 basic runes, storage box and dividers. $34.99.</div>
        </div>
      </div>
      <div style="display:flex;flex-direction:column;background:#18151F;border:1px solid #2D2838;border-radius:12px;overflow:hidden">
        <div style="height:150px;background:#000;display:flex;align-items:center;justify-content:center;padding:10px"><img src="/riftbound/prerift-kit.jpg" alt="Radiance Pre-Rift player kit" style="max-width:100%;max-height:100%;object-fit:contain"></div>
        <div style="padding:14px 16px 16px">
          <div style="font-weight:600;color:#F6F1FA">Pre‑Rift Kit</div>
          <div style="font-size:14px;color:#A69DB4;margin-top:2px">Event only, Oct 16. Mini‑deck, five boosters, promo. Not sold separately.</div>
        </div>
      </div>
    </div>
  </section>

  <section style="margin-top:52px">
    <h2 style="font-family:'Cinzel',Georgia,serif;font-size:clamp(22px,2.4vw,28px);font-weight:700;margin:0;color:#F6F1FA">Three kinds of night</h2>
    <div style="width:44px;height:2px;margin:8px 0 18px;background:linear-gradient(90deg,#6FB2E8,transparent)"></div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:16px">
      <div style="position:relative;display:flex;flex-direction:column;gap:10px;background:#18151F;border:1px solid #2D2838;border-radius:12px;padding:22px 20px 18px;overflow:hidden">
        <div style="position:absolute;left:0;right:0;top:0;height:3px;background:#5CCB86"></div>
        <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap">
          <h3 style="margin:0;font-size:21px;color:#F6F1FA">Nexus Night</h3>
          <span style="font-family:'Barlow Semi Condensed',sans-serif;font-weight:600;font-size:13px;letter-spacing:.04em;padding:1px 9px;border-radius:999px;border:1px solid #5CCB86;color:#5CCB86;white-space:nowrap">Casual · Weekly</span>
        </div>
        <p style="margin:0;color:#A69DB4;font-size:15px">Riot's weekly store program, the Riftbound equivalent of Friday night locals. Relaxed pairings, a Nexus Night promo pack for playing (while supplies last), and a format the store picks each week. This is the one we run every Friday.</p>
        <dl style="margin:auto 0 0;padding-top:12px;border-top:1px solid #2D2838;display:grid;grid-template-columns:auto 1fr;gap:4px 14px;font-size:14px">
          <dt style="color:#756D84;font-family:'Barlow Semi Condensed',sans-serif;font-weight:600;letter-spacing:.06em;text-transform:uppercase;font-size:12px;padding-top:2px">Format</dt><dd style="margin:0;color:#E9E4EE">Constructed, Sealed, or Modified Champion Deck</dd>
          <dt style="color:#756D84;font-family:'Barlow Semi Condensed',sans-serif;font-weight:600;letter-spacing:.06em;text-transform:uppercase;font-size:12px;padding-top:2px">Bring</dt><dd style="margin:0;color:#E9E4EE">A deck, or borrow one of ours</dd>
        </dl>
      </div>
      <div style="position:relative;display:flex;flex-direction:column;gap:10px;background:#18151F;border:1px solid #2D2838;border-radius:12px;padding:22px 20px 18px;overflow:hidden">
        <div style="position:absolute;left:0;right:0;top:0;height:3px;background:#E4B45A"></div>
        <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap">
          <h3 style="margin:0;font-size:21px;color:#F6F1FA">Pre‑Rift</h3>
          <span style="font-family:'Barlow Semi Condensed',sans-serif;font-weight:600;font-size:13px;letter-spacing:.04em;padding:1px 9px;border-radius:999px;border:1px solid #E4B45A;color:#E4B45A;white-space:nowrap">Casual · Per set</span>
        </div>
        <p style="margin:0;color:#A69DB4;font-size:15px">The prerelease. About a week before each set launches, you get a Pre‑Rift kit: a 15‑card seeded Legend pack (one of six Champions), five booster packs, and a stamped Pre‑Rift promo. Build a deck from only what you opened, then play. Everything you open is yours.</p>
        <dl style="margin:auto 0 0;padding-top:12px;border-top:1px solid #2D2838;display:grid;grid-template-columns:auto 1fr;gap:4px 14px;font-size:14px">
          <dt style="color:#756D84;font-family:'Barlow Semi Condensed',sans-serif;font-weight:600;letter-spacing:.06em;text-transform:uppercase;font-size:12px;padding-top:2px">Format</dt><dd style="margin:0;color:#E9E4EE">Sealed, three best‑of‑one rounds</dd>
          <dt style="color:#756D84;font-family:'Barlow Semi Condensed',sans-serif;font-weight:600;letter-spacing:.06em;text-transform:uppercase;font-size:12px;padding-top:2px">Rules</dt><dd style="margin:0;color:#E9E4EE">Up to three domains; runes provided by the store</dd>
          <dt style="color:#756D84;font-family:'Barlow Semi Condensed',sans-serif;font-weight:600;letter-spacing:.06em;text-transform:uppercase;font-size:12px;padding-top:2px">Prizes</dt><dd style="margin:0;color:#E9E4EE">Booster packs from the new set</dd>
        </dl>
      </div>
      <div style="position:relative;display:flex;flex-direction:column;gap:10px;background:#18151F;border:1px solid #2D2838;border-radius:12px;padding:22px 20px 18px;overflow:hidden">
        <div style="position:absolute;left:0;right:0;top:0;height:3px;background:#E06A58"></div>
        <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap">
          <h3 style="margin:0;font-size:21px;color:#F6F1FA">Summoner Skirmish</h3>
          <span style="font-family:'Barlow Semi Condensed',sans-serif;font-weight:600;font-size:13px;letter-spacing:.04em;padding:1px 9px;border-radius:999px;border:1px solid #E06A58;color:#E06A58;white-space:nowrap">Competitive · Retiring</span>
        </div>
        <p style="margin:0;color:#A69DB4;font-size:15px">The top of local competitive play in 2026. Radiance has two windows: Nov 9 – Dec 13 and Dec 14 – Jan 17, one event each. Deck registration required; tournament rules apply. No cash prizes are allowed under Riot's play policy, so store credit and boosters top up the pool. Riot is retiring the Skirmish after Radiance; these final ones run without a Regional bye. <a href="#changes">What replaces it →</a></p>
        <dl style="margin:auto 0 0;padding-top:12px;border-top:1px solid #2D2838;display:grid;grid-template-columns:auto 1fr;gap:4px 14px;font-size:14px">
          <dt style="color:#756D84;font-family:'Barlow Semi Condensed',sans-serif;font-weight:600;letter-spacing:.06em;text-transform:uppercase;font-size:12px;padding-top:2px">Format</dt><dd style="margin:0;color:#E9E4EE">1v1 Constructed, best of three</dd>
          <dt style="color:#756D84;font-family:'Barlow Semi Condensed',sans-serif;font-weight:600;letter-spacing:.06em;text-transform:uppercase;font-size:12px;padding-top:2px">Structure</dt><dd style="margin:0;color:#E9E4EE">Swiss rounds, top cut at 9+ players</dd>
          <dt style="color:#756D84;font-family:'Barlow Semi Condensed',sans-serif;font-weight:600;letter-spacing:.06em;text-transform:uppercase;font-size:12px;padding-top:2px">Prizes</dt><dd style="margin:0;color:#E9E4EE">32 participation promos, 8 Top Cut promos, Champion promo and playmat</dd>
        </dl>
      </div>
    </div>
  </section>

  <section id="changes" style="margin-top:52px">
    <h2 style="font-family:'Cinzel',Georgia,serif;font-size:clamp(22px,2.4vw,28px);font-weight:700;margin:0;color:#F6F1FA">What changes in 2027</h2>
    <div style="width:44px;height:2px;margin:8px 0 18px;background:linear-gradient(90deg,#9B6BE0,transparent)"></div>
    <p style="color:#A69DB4;max-width:76ch;margin:0 0 18px;text-wrap:pretty">Riot's August 2026 State of Play redrew organized play. Too many Skirmish byes went unused, so the Skirmish is being split into two programs that each do one job. Pre‑Rift and Nexus Night stay exactly as they are.</p>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px">
      <div style="background:#18151F;border:1px solid #2D2838;border-radius:12px;padding:20px;display:flex;flex-direction:column;gap:6px">
        <div style="font-family:'Barlow Semi Condensed',sans-serif;font-size:13px;letter-spacing:.12em;text-transform:uppercase;font-weight:600;color:#D4A64A">New · Monthly · In store</div>
        <h3 style="margin:0;font-size:20px;color:#F6F1FA">Nexus Cup</h3>
        <p style="margin:0;color:#A69DB4;font-size:15px">A monthly local championship that crowns a store champion without feeding into the competitive ladder. Competitive on the night, no pressure beyond it.</p>
      </div>
      <div style="background:#18151F;border:1px solid #2D2838;border-radius:12px;padding:20px;display:flex;flex-direction:column;gap:6px">
        <div style="font-family:'Barlow Semi Condensed',sans-serif;font-size:13px;letter-spacing:.12em;text-transform:uppercase;font-weight:600;color:#E06A58">New · Curated stores</div>
        <h3 style="margin:0;font-size:20px;color:#F6F1FA">Riftbound Challenge Series</h3>
        <p style="margin:0;color:#A69DB4;font-size:15px">The first rung of the 2027 ladder and the true Skirmish successor. Instead of thousands of overlapping events, it runs through a curated network of stores each season.</p>
      </div>
      <div style="background:#18151F;border:1px solid #2D2838;border-radius:12px;padding:20px;display:flex;flex-direction:column;gap:6px">
